# ---- Tambahkan / ubah di file .env ----
APP_NAME="Antrian Pasien"
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_URL=https://domain-anda.example

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=antrian_pasien
DB_USERNAME=root
DB_PASSWORD=

# Pengaturan antrian
QUEUE_MAX_NUMBER=99
QUEUE_SHIFT_STEPS=3
QUEUE_NEAR_THRESHOLD=2
QUEUE_MAX_CALLS=3
QUEUE_RECALL_WAIT_MINUTES=2
DATA_RETENTION_DAYS=30

# Password akun admin pertama (username: admin). Jika kosong, dibuat acak saat seeding.
ADMIN_PASSWORD=

# Web Push: isi dari hasil `php artisan push:vapid`
VAPID_SUBJECT=mailto:admin@domain-anda.example
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
